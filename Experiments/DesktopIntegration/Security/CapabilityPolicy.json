{
  "schemaVersion": 2,
  "bundleIdentifier": "devyashtanwar.whatsapp-blur-auto-beta",
  "entitlements": {
    "com.apple.security.app-sandbox": true
  },
  "forbiddenCapabilities": [
    "network",
    "microphone",
    "camera",
    "location",
    "personal-files",
    "contacts",
    "calendar",
    "photos",
    "bluetooth",
    "usb",
    "accessibility",
    "keyboard",
    "clipboard",
    "secret-storage",
    "external-url-opening",
    "shell-execution"
  ],
  "allowedResources": [
    "capability-policy.json",
    "source-manifest.json"
  ],
  "captureScope": "automatic-independent-authenticated-whatsapp-windows",
  "preferenceScope": "private-container-non-content-blur-preferences"
}
