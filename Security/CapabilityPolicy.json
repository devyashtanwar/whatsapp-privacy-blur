{
  "schemaVersion": 1,
  "bundleIdentifier": "devyashtanwar.whatsapp-privacy-cover",
  "entitlements": {
    "com.apple.security.app-sandbox": true
  },
  "forbiddenCapabilities": [
    "network",
    "microphone",
    "camera",
    "location",
    "personal-files",
    "contacts",
    "calendar",
    "photos",
    "bluetooth",
    "usb",
    "screen-capture",
    "accessibility",
    "keyboard",
    "clipboard",
    "secret-storage",
    "external-url-opening",
    "shell-execution",
    "persistent-settings"
  ],
  "allowedResources": [
    "capability-policy.json",
    "source-manifest.json"
  ]
}
